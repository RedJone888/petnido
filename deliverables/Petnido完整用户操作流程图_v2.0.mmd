flowchart TB

%% =========================
%% 轨迹1：首页、浏览与登录
%% =========================
subgraph T1["轨迹1：首页、公开浏览与登录"]
direction TB

H0["首页"] --> H1["浏览附近需求"]
H0 --> H2["浏览附近服务者"]
H0 --> H3["浏览公开服务"]
H0 --> H4["照护知识 / 类型介绍"]
H0 --> H5["登录 / 注册"]

H1 --> ND["需求详情"]
H2 --> SP["服务者资料"]
H3 --> SD["服务详情"]
SP --> SD

ND --> NA{"用户操作"}
NA -->|收藏| NF["加入收藏"]
NA -->|咨询或应聘| AUTH1{"是否登录"}

SD --> SA{"用户操作"}
SA -->|收藏| SF["加入收藏"]
SA -->|咨询或预约| AUTH2{"是否登录"}

AUTH1 -->|否| H5
AUTH1 -->|是| APPLY0["进入咨询 / 应聘流程"]

AUTH2 -->|否| H5
AUTH2 -->|是| BOOK0["进入咨询 / 预约流程"]
end


%% =========================
%% 轨迹2：登录与首次注册分流
%% =========================
subgraph T2["轨迹2：登录与首次注册分流"]
direction TB

H5 --> L0["完成登录或注册"]
L0 --> L1{"是否首次注册"}

L1 -->|否| C0["直接进入个人中心"]
L1 -->|是| L2["完善基础资料<br/>头像、昵称"]

L2 --> L3{"现在想做什么"}
L3 -->|发布需求| N0["进入发布需求流程"]
L3 -->|提供服务| S0["进入服务开通流程"]
L3 -->|暂时跳过| C0

C0 --> C1["用户自行选择操作<br/>不主动弹出查看消息提示"]
end


%% =========================
%% 轨迹3：发布需求
%% =========================
subgraph T3["轨迹3：发布需求"]
direction TB

C1 -->|发布需求| N0
N0 --> N1["选择需求类型"]

N1 -->|上门| N2A["填写上门需求前置内容<br/>时间、频率、上门次数等"]
N1 -->|寄养| N2B["填写寄养需求前置内容<br/>时间、寄养条件、接送方式等"]
N1 -->|自定义| N2C["填写自定义需求前置内容<br/>时间、任务等"]

N2A --> N3["表单进行到宠物步骤"]
N2B --> N3
N2C --> N3

N3 --> N4{"个人资料中是否有宠物档案"}

N4 -->|有| N5["选择已有宠物<br/>允许查看或临时修改本次信息"]
N4 -->|没有或不适用| N6["在当前表单中新建宠物资料"]

N5 --> N7["继续填写当前类型的需求内容<br/>任务、物资、环境要求等"]
N6 --> N7

N7 --> N8["表单进行到地图位置步骤"]
N8 --> N9{"个人资料中是否有可用位置"}

N9 -->|有| N10["默认使用档案位置<br/>用户可以修改本次地图选点"]
N9 -->|没有| N11["在地图选择位置<br/>只保存经纬度，不采集精确地址"]

N10 --> N12["继续填写后续内容<br/>预算、交通费、接送费等"]
N11 --> N12

N12 --> N13["预览需求"]
N13 --> N14{"确认发布"}
N14 -->|返回修改| N1
N14 -->|确认| N15["需求发布成功"]

N15 --> N16["自动将本次宠物资料<br/>保存或更新到宠物档案"]
N15 --> N17["自动将本次地图位置<br/>保存或更新到位置档案"]

N16 --> NE0
N17 --> NE0

NE0{"是否已开通邮箱消息通知"}
NE0 -->|已开通| NR0["开始需求匹配"]
NE0 -->|未开通| NE1{"是否接受在收到消息后<br/>立即发送邮件通知"}
NE1 -->|接受| NE2["开通邮箱通知<br/>必要时完成邮箱绑定或验证"]
NE1 -->|暂不接受| NR0
NE2 --> NR0

NR0 --> NR1{"是否有高度匹配的服务"}
NR1 -->|有| NR2["提示：找到符合需求的服务<br/>是否查看"]
NR2 -->|查看| NR3["匹配服务列表"]
NR2 -->|暂不查看| MN["我的需求详情"]

NR1 -->|没有| NR4["提示：暂未找到完全匹配服务<br/>是否查看照顾相同宠物的其他类别服务"]
NR4 -->|查看| NR5["相同宠物的相关服务列表"]
NR4 -->|暂不查看| MN

NR3 --> SD
NR5 --> SD
end


%% =========================
%% 轨迹4：开通并发布服务
%% =========================
subgraph T4["轨迹4：开通并发布服务"]
direction TB

C1 -->|发布服务| S0
S0 --> S1{"是否已有服务档案"}

S1 -->|没有| S2["确认开启接单模式"]
S2 --> S3["创建服务档案<br/>个人经验、个人介绍等"]
S1 -->|已有| S4["读取现有服务档案"]
S3 --> S5["选择服务类型"]
S4 --> S5

S5 -->|上门服务| S6A["填写上门服务前置内容<br/>服务时间、宠物范围、经验等"]
S5 -->|寄养服务| S6B["填写寄养服务前置内容<br/>宠物范围、环境、容量等"]
S5 -->|自定义服务| S6C["填写自定义服务前置内容<br/>时间、内容、宠物类型等"]

S6A --> S7["表单进行到服务地点步骤"]
S6B --> S7
S6C --> S7

S7 --> S8{"服务档案中是否有默认地点"}

S8 -->|有| S9["提供档案中的地点和范围<br/>用户可直接使用或修改"]
S8 -->|没有| S10["填写新的服务地点和范围"]

S9 --> S11["继续填写当前类型内容<br/>任务、环境、证明照片、优惠等"]
S10 --> S11

S11 --> S12["表单进行到费用与货币单位步骤"]
S12 --> S13{"服务档案中是否有常用货币"}

S13 -->|有| S14["默认使用常用货币<br/>用户可以修改"]
S13 -->|没有| S15["选择货币单位"]

S14 --> S16["填写服务价格和优惠规则"]
S15 --> S16

S16 --> S17["预览服务"]
S17 --> S18{"确认发布"}
S18 -->|返回修改| S5
S18 -->|确认| S19["服务发布成功并自动公开"]

S19 --> S20["自动将本次服务地点<br/>保存或更新到服务档案"]
S19 --> S21["自动将本次货币单位<br/>保存或更新到服务档案"]

S20 --> SE0
S21 --> SE0

SE0{"是否已开通邮箱消息通知"}
SE0 -->|已开通| SR0["开始需求匹配"]
SE0 -->|未开通| SE1{"是否接受在收到消息后<br/>立即发送邮件通知"}
SE1 -->|接受| SE2["开通邮箱通知<br/>必要时完成邮箱绑定或验证"]
SE1 -->|暂不接受| SR0
SE2 --> SR0

SR0 --> SR1{"是否有匹配需求"}

SR1 -->|有| SR2["提示：找到匹配需求<br/>是否查看"]
SR2 -->|查看匹配需求| SR3["匹配需求列表"]
SR2 -->|看看附近需求| SR4["附近需求列表"]
SR2 -->|暂不查看| MS["我的服务详情"]

SR1 -->|没有| SR5["提示：暂未找到完全匹配需求<br/>是否查看附近需求"]
SR5 -->|查看| SR4
SR5 -->|暂不查看| MS

SR3 --> ND
SR4 --> ND
end


%% =========================
%% 轨迹5：应聘与需求确认
%% =========================
subgraph T5["轨迹5：咨询、应聘与需求确认"]
direction TB

APPLY0 --> A1{"选择咨询还是应聘"}

A1 -->|咨询| CHAT1["创建聊天会话"]
A1 -->|应聘| A2{"应聘者是否有服务档案"}

A2 -->|有| A3["提示需求发布者<br/>可以查看应聘者服务档案"]
A2 -->|没有| A4["提示需求发布者<br/>该用户暂无服务档案，请通过聊天了解经验"]

A3 --> A5["发送应聘申请并创建聊天"]
A4 --> A5

A5 --> A6["状态：等待需求发布者回复"]
A6 --> A7{"发布者处理"}

A7 -->|确认| A8["应聘成功"]
A7 -->|拒绝| A9["应聘未通过"]
A7 -->|继续沟通| CHAT1

A8 --> A10["需求状态：已找到服务者"]
A10 --> A11["需求从公开搜索列表中隐藏"]

A10 --> A12{"发布者是否取消已确认服务者"}
A12 -->|是，且需求未过期| A13["需求恢复为公开状态"]
A12 -->|否| A14["保持已找到服务者状态"]
end


%% =========================
%% 轨迹6：预约与服务确认
%% =========================
subgraph T6["轨迹6：咨询、预约与服务确认"]
direction TB

BOOK0 --> B1{"选择咨询还是预约"}

B1 -->|咨询| CHAT2["创建聊天会话"]
B1 -->|预约| B2["选择预约时间段"]

B2 --> B3["查看该日期已有成功预约数量"]
B3 --> B4{"是否为寄养服务"}

B4 -->|否| B6["发送预约申请并创建聊天"]
B4 -->|是| B4A{"按宠物数量计算<br/>是否仍有接待容量"}
B4A -->|没有| B5["提示时间冲突或宠物容量已满<br/>建议选择其他时间"]
B4A -->|有| B6

B6 --> B7["状态：等待服务者确认"]
B7 --> B8{"服务者处理"}

B8 -->|确认| B9["预约成功"]
B8 -->|拒绝| B10["预约未通过"]
B8 -->|继续沟通| CHAT2

B9 --> B11["更新服务日期的成功预约数量"]
B9 --> B12{"服务者是否取消确认"}
B12 -->|是| B13["预约恢复为待处理或已取消"]
B12 -->|否| B14["保持预约成功"]
end


%% =========================
%% 个人中心：用户业务操作（不含运营治理）
%% =========================
subgraph T7["个人中心：用户自行管理"]
direction LR

C0 --> PC1["消息中心"]
C0 --> PC2["我的需求"]
C0 --> PC3["我的服务"]
C0 --> PC4["我的应聘 / 预约"]
C0 --> PC5["收藏夹"]
C0 --> PC6["个人资料"]
C0 --> PC7["服务档案"]
C0 --> PC8["通知与语言设置"]

PC2 --> MN
PC3 --> MS

PC6 --> PET["宠物档案"]
PC6 --> LOC["地图位置档案<br/>只保存经纬度"]
PC6 --> BASE["头像、昵称、地理位置"]

PC7 --> SERVICEPROFILE["经验介绍、服务地点<br/>常用货币单位"]
PC7 --> BATCH["批量管理<br/>开启或关闭全部服务<br/>统一修改地点或货币"]

PC3 --> SINGLE["单个服务管理<br/>编辑、暂停、开启、删除"]

PC5 --> FAV["收藏的需求与服务<br/>包括已经过期的需求"]

PC8 --> EMAIL["邮箱绑定与消息通知"]
PC8 --> LANG["三种语言切换"]
end


%% =========================
%% 档案复用关系
%% =========================
PET -. "到达宠物步骤时提供选择" .-> N3
LOC -. "到达位置步骤时提供默认地图选点" .-> N8
SERVICEPROFILE -. "到达地点步骤时提供默认值" .-> S7
SERVICEPROFILE -. "到达货币步骤时提供默认值" .-> S12

N16 -. "发布成功后更新" .-> PET
N17 -. "发布成功后更新" .-> LOC
S20 -. "发布成功后更新" .-> SERVICEPROFILE
S21 -. "发布成功后更新" .-> SERVICEPROFILE

%% =========================
%% 登录后的原操作回跳
%% =========================
L0 -. "登录完成后继续之前操作" .-> AUTH1
L0 -. "登录完成后继续之前操作" .-> AUTH2
