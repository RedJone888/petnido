# Application
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_RATE_LIMIT_SECRET=replace-with-a-separate-long-random-secret
PENDING_ACTION_SECRET=replace-with-a-separate-long-random-secret

# PostgreSQL / Prisma
DATABASE_URL=postgresql://petnido:petnido@localhost:5432/petnido
# Optional direct (non-pooled) connection supplied by providers such as Neon.
# Keep this secret local; migration commands in this project currently read DATABASE_URL.
DIRECT_URL=

# Tests only. Reset scripts refuse databases whose name does not contain "test".
TEST_DATABASE_URL=postgresql://petnido:petnido@localhost:5432/petnido_test
ALLOW_TEST_DB_RESET=false

# Architecture validation slice (non-production only)
FEATURE_VERTICAL_SLICE=false
VALIDATION_DATABASE_URL=file:./validation.local.db
VALIDATION_TEST_TOKEN=replace-with-a-local-test-token

# Email delivery can be disabled independently for local mail testing.
FEATURE_EMAIL_OUTBOX=false

# OAuth providers (optional; leave empty to disable in local development)
# Register these exact local callback URLs in the provider consoles:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/line
# Production callbacks must use the same origin as AUTH_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# Cloudinary uploads (required only for real image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (required only for verification and notification delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Petnido <no-reply@example.com>
EMAIL_WORKER_SECRET=
APP_URL=http://localhost:3000

# Map and geocoding
NEXT_PUBLIC_MAPTILER_KEY=
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=Petnido/0.1 (contact@example.com)

# Reserved / currently out of scope
REDIS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
INTERNAL_JOB_TOKEN="replace-with-a-long-random-secret"
